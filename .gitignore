# ============================================================
# PRIVATE PROJECT CODEBASES — NEVER COMMIT THESE DIRECTORIES
# Leading / anchors each rule to the repo root only,
# preventing case-insensitive Windows matches inside subdirs.
# ============================================================
# Exact folder names live in .git/info/exclude (local only). These catch
# downloaded repo archives at the root as a safety net.
/*-main/
/*-master/

# Environment and secrets
*.env
.env
.env.*
*.key
*.pem
secrets/

# Python artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Node / frontend artifacts
node_modules/
.npm
*.log

# OS artifacts
.DS_Store
Thumbs.db
desktop.ini

# Editor artifacts
.vscode/
.idea/
*.swp
*.swo

# Temp / local files
*.tmp
*.bak
.cache/
.superpowers/
references/
# Astro
.astro/
.playwright-mcp/
_legacy/

# Blog: local-only drafts and admin trash
src/content/drafts/
src/content/.trash/
# Blog admin local state (checked passages)
admin/.state.json
