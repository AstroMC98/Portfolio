---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';
import '../styles/global.css';
import { PROFILE } from '../data/profile';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** Social share image path (default: the site card /og.png). */
  image?: string;
  /** Alt text for the share image. */
  imageAlt?: string;
  /** Open Graph type; posts pass 'article'. */
  ogType?: 'website' | 'article';
  /** Article metadata for Open Graph (posts only). */
  article?: { published: Date; modified?: Date; tags?: string[]; section?: string };
  /** Extra JSON-LD objects for this page (e.g. a BlogPosting). */
  jsonLd?: Record<string, unknown>[];
}

const {
  title = 'Marc Castro · Forward-Deployed AI Engineer (RAG, LLMOps)',
  description = 'Forward-deployed AI engineer who embeds with enterprise teams and ships RAG, agentic workflows, document intelligence and LLMOps into their production. 6+ years, 30+ production projects, ex-AIA and TDCX AI.',
  noindex = false,
  image = '/og.png',
  imageAlt = 'Marc Castro — I build AI systems that survive production.',
  ogType = 'website',
  article,
  jsonLd: pageJsonLd = [],
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const iso = (d: Date) => d.toISOString();

/** The Person entity every page (and every BlogPosting's author) points at. */
const PERSON_ID = new URL('/#person', Astro.site).toString();
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': PERSON_ID,
  name: PROFILE.name,
  jobTitle: PROFILE.role,
  url: Astro.site?.toString(),
  email: `mailto:${PROFILE.email}`,
  sameAs: [PROFILE.github, PROFILE.linkedin],
  alumniOf: PROFILE.education.map((e) => ({ '@type': 'CollegeOrUniversity', name: e.school })),
  knowsAbout: ['Retrieval-augmented generation', 'AI agents', 'LLMOps', 'Document intelligence', 'Machine learning'],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0a0d0c" />

    <link rel="icon" href="/images/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />

    <link rel="alternate" type="application/rss+xml" title="Marc Castro — Writing" href="/blog/rss.xml" />

    <meta property="og:site_name" content="Marc Castro" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    {article && <meta property="article:published_time" content={iso(article.published)} />}
    {article && <meta property="article:modified_time" content={iso(article.modified ?? article.published)} />}
    {article && <meta property="article:author" content={Astro.site?.toString()} />}
    {article?.section && <meta property="article:section" content={article.section} />}
    {article?.tags?.map((t) => <meta property="article:tag" content={t} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {pageJsonLd.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
