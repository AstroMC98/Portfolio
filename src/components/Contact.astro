---
import { PROFILE } from '../data/profile';
import Logo from './Logo.astro';
const year = new Date().getFullYear();
---
<section class="contact" id="contact" aria-labelledby="contact-title">
  <div class="wrap">
    <p class="eyebrow" data-reveal><span class="idx">09</span> Contact</p>
    <h2 id="contact-title" class="contact__title" data-reveal>
      Let’s ship something <em>real.</em>
    </h2>

    <div class="contact__grid" data-reveal>
      <div class="contact__mail">
        <span class="mono">Email — fastest reply</span>
        <a class="contact__email" href={`mailto:${PROFILE.email}`}>{PROFILE.email}</a>
        <button class="btn btn--sm" data-copy={PROFILE.email}>
          <span data-copy-label>Copy address</span>
        </button>
      </div>
      <ul class="contact__links">
        <li><a href={PROFILE.resume} download><span class="mono">Résumé</span><span>Download PDF</span><span aria-hidden="true">↓</span></a></li>
        <li><a href={PROFILE.linkedin} target="_blank" rel="noopener"><span class="mono">LinkedIn</span><span>{PROFILE.linkedinLabel}</span><span aria-hidden="true">↗</span></a></li>
        <li><a href={PROFILE.github} target="_blank" rel="noopener"><span class="mono">GitHub</span><span>{PROFILE.githubLabel}</span><span aria-hidden="true">↗</span></a></li>
        <li><a href={PROFILE.calendly} target="_blank" rel="noopener" data-calendly><span class="mono">Calendar</span><span>Book a 30-minute call</span><span aria-hidden="true">→</span></a></li>
      </ul>
      <p class="contact__consult">
        <span class="mono">Also</span> taking select consulting engagements — enterprise RAG, agentic automation and AI enablement for
        teams. <a href={PROFILE.calendly} target="_blank" rel="noopener" data-calendly>Scope a project →</a>
      </p>
    </div>
  </div>

  <footer class="foot wrap">
    <a href="/"><Logo size={28} lockup /></a>
    <span class="mono">© {year} Marc Castro</span>
    <span class="mono">Designed &amp; engineered in-house · Astro · GSAP</span>
    <a class="mono" href="#top">Back to top ↑</a>
  </footer>
</section>

<style>
  .contact {
    position: relative;
    padding-top: var(--section-pad);
    border-top: 1px solid var(--line);
    background: radial-gradient(1200px 600px at 20% 110%, rgb(61 245 167 / 0.12), transparent 65%);
    overflow: hidden;
  }
  .contact__title {
    margin-top: 28px;
    font-family: var(--font-display);
    font-stretch: 72%;
    font-weight: 700;
    font-size: clamp(3.25rem, 1rem + 9vw, 10.5rem);
    line-height: 0.9;
    letter-spacing: -0.015em;
  }
  .contact__title em { font-style: normal; font-weight: inherit; color: var(--signal); }
  .contact__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 80px);
    margin-top: clamp(48px, 6vw, 88px);
    padding-bottom: clamp(64px, 8vw, 120px);
  }
  .contact__mail { display: grid; gap: 14px; justify-items: start; align-content: start; }
  .contact__mail .mono { font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); }
  .contact__email {
    font-family: var(--font-display);
    font-stretch: 84%;
    font-size: clamp(1.4rem, 0.9rem + 2vw, 2.5rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    border-bottom: 2px solid var(--signal);
    word-break: break-all;
    transition: color 0.2s;
  }
  .contact__email:hover { color: var(--signal); }
  .contact__links { border-top: 1px solid var(--line); }
  .contact__consult { grid-column: 1 / -1; padding: 18px 20px; border: 1px dashed var(--line-2); border-radius: 12px; color: var(--text-2); font-size: 0.95rem; }
  .contact__consult .mono { font-size: 10.5px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--signal); margin-right: 8px; }
  .contact__consult a { color: var(--signal); font-weight: 600; white-space: nowrap; }
  .contact__links a {
    display: grid;
    grid-template-columns: 110px 1fr auto;
    gap: 16px;
    align-items: center;
    padding: 20px 4px;
    border-bottom: 1px solid var(--line);
    transition: color 0.2s, padding 0.3s var(--ease-out);
  }
  .contact__links a:hover { color: var(--signal); padding-left: 12px; }
  .contact__links .mono { font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); }
  .foot {
    display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap;
    padding-block: 28px;
    border-top: 1px solid var(--line);
    font-size: 11.5px;
    color: var(--muted);
  }
  .foot a:hover { color: var(--signal); }
  @media (max-width: 860px) {
    .contact__grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 480px) {
    .contact__links a { grid-template-columns: 1fr auto; }
    .contact__links .mono { grid-column: 1 / -1; }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const label = btn.querySelector<HTMLElement>('[data-copy-label]')!;
      try {
        await navigator.clipboard.writeText(btn.dataset.copy!);
        label.textContent = 'Copied ✓';
      } catch {
        label.textContent = 'Copy failed — select the address above';
      }
      setTimeout(() => (label.textContent = 'Copy address'), 2200);
    });
  });
</script>
