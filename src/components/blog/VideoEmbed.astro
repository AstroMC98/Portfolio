---
/**
 * Click-to-play YouTube embed for official uploads (trailers, clips).
 * Shows the video's own poster frame; the player (youtube-nocookie.com) only loads when the reader
 * presses play, so the page stays fast and no YouTube cookies are set before then.
 * Without JS, the poster links to the video on YouTube.
 */
interface Props {
  /** YouTube video id (11 characters). */
  id: string;
  /** Accessible title for the player. */
  title: string;
  caption?: string;
  /** Rights line, e.g. "Sentai Filmworks · © Bones". */
  credit?: string;
}
const { id, title, caption, credit } = Astro.props;
const watch = `https://www.youtube.com/watch?v=${id}`;
---
<figure class="video" data-video={id} data-title={title}>
  <a class="video__frame" href={watch} target="_blank" rel="noopener" aria-label={`Play video: ${title}`}>
    <img
      src={`https://i.ytimg.com/vi/${id}/maxresdefault.jpg`}
      onerror={`this.onerror=null;this.src='https://i.ytimg.com/vi/${id}/hqdefault.jpg'`}
      alt=""
      loading="lazy"
      decoding="async"
      width="1280"
      height="720"
    />
    <span class="video__play" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="30" height="30"><path d="M8 5.5v13l11-6.5z" fill="currentColor" /></svg>
    </span>
    <span class="video__badge mono" aria-hidden="true">Play · YouTube</span>
  </a>
  {(caption || credit) && (
    <figcaption>
      {caption && <span>{caption}</span>}
      {credit && <span class="video__credit mono">{credit}</span>}
    </figcaption>
  )}
</figure>

<style>
  .video { margin: 2.2em 0; }
  .video__frame { position: relative; display: block; aspect-ratio: 16 / 9; overflow: hidden; border-radius: 16px; border: 1px solid var(--line); background: #000; }
  .video__frame img { width: 100%; height: 100%; object-fit: cover; opacity: 0.88; transition: opacity 0.25s, transform 0.6s; }
  .video__frame:hover img { opacity: 1; transform: scale(1.015); }
  .video__play { position: absolute; left: 50%; top: 50%; display: grid; place-items: center; width: 74px; height: 74px; margin: -37px 0 0 -37px; border-radius: 50%; background: var(--signal); color: var(--ink); box-shadow: 0 10px 40px rgb(0 0 0 / 0.5); transition: transform 0.2s; }
  .video__frame:hover .video__play, .video__frame:focus-visible .video__play { transform: scale(1.08); }
  .video__frame:focus-visible { outline: 2px solid var(--signal); outline-offset: 3px; }
  .video__badge { position: absolute; right: 14px; top: 12px; padding: 4px 10px; border-radius: 999px; background: rgb(10 13 12 / 0.75); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-2); }
  .video iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  figcaption { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 16px; margin-top: 10px; font-size: 0.86rem; color: var(--text-2); }
  .video__credit { font-size: 11px; letter-spacing: 0.04em; color: var(--muted); }
</style>

<script>
  // Swap the poster for the real player on click (privacy-enhanced domain, autoplay once requested).
  document.querySelectorAll<HTMLElement>('figure.video').forEach((fig) => {
    const link = fig.querySelector<HTMLAnchorElement>('.video__frame');
    link?.addEventListener('click', (e) => {
      e.preventDefault();
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${fig.dataset.video}?autoplay=1&rel=0`;
      iframe.title = fig.dataset.title ?? 'Video';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      const frame = document.createElement('div');
      frame.className = 'video__frame';
      // Carry Astro's scoped-style attribute over so the new elements pick up this component's CSS.
      for (const a of Array.from(link.attributes)) {
        if (a.name.startsWith('data-astro-cid')) { frame.setAttribute(a.name, a.value); iframe.setAttribute(a.name, a.value); }
      }
      frame.append(iframe);
      link.replaceWith(frame);
      iframe.focus();
    });
  });
</script>
