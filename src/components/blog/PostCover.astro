---
/**
 * Generative cover art — one line-drawn motif per post, in the site's signal palette.
 * Deterministic (seeded by slug) so it never changes between builds.
 */
interface Props {
  motif: string;
  slug: string;
  index?: string;
  compact?: boolean;
  banner?: boolean;
}
const { motif, slug, index, compact = false, banner = false } = Astro.props;

let seed = [...slug].reduce((a, c) => (a * 31 + c.charCodeAt(0)) >>> 0, 7);
const rnd = () => ((seed = (seed * 1664525 + 1013904223) >>> 0) / 4294967296);

const W = 1200;
const H = 640;
const M = '#3df5a7';
const T = '#ecefea';
const D = '#2a3732';
const range = (n: number) => Array.from({ length: n }, (_, i) => i);

// Pre-computed geometry per motif
const branches = range(7).map((i) => ({ y: 120 + i * 70, bend: 380 + rnd() * 260, end: 980 + rnd() * 140, hl: i === 3 }));
const drift = range(3).map((i) => ({ mu: 380 + i * 210, sigma: 90 + i * 22, hl: i === 2 }));
const gauss = (mu: number, s: number, amp: number) =>
  range(121).map((k) => {
    const x = 120 + k * 8;
    const y = 520 - amp * Math.exp(-((x - mu) ** 2) / (2 * s * s));
    return `${k ? 'L' : 'M'}${x} ${y.toFixed(1)}`;
  }).join(' ');
const bits = range(12 * 6).map((i) => ({ x: 240 + (i % 12) * 62, y: 150 + Math.floor(i / 12) * 62, on: rnd() > 0.45, hl: rnd() > 0.88 }));
const civic = range(9 * 4).map((i) => ({ x: 180 + (i % 9) * 100, y: 170 + Math.floor(i / 9) * 100, lit: rnd() > 0.72 }));
// fork: a scattered constellation of client nodes (seeded), joined in visiting order
const clients = range(7).map((i) => ({ x: 780 + (i % 4) * 85 + rnd() * 40, y: 390 + Math.floor(i / 4) * 95 + rnd() * 40, hl: i === 2 || i === 5 }));
// sketch: a hand-drawn rectangle — each corner nudged a little, drawn twice like a pencil pass
const wobble = (x: number, y: number, w: number, h: number) => {
  const j = () => (rnd() - 0.5) * 14;
  const pts = [[x + j(), y + j()], [x + w + j(), y + j()], [x + w + j(), y + h + j()], [x + j(), y + h + j()]];
  return `M${pts.map((p) => p.map((v) => v.toFixed(1)).join(' ')).join(' L')} Z`;
};
const sketchBoxes = [[150, 150, 330, 70], [150, 250, 150, 230], [320, 250, 160, 100], [320, 380, 160, 100]];
const sketchPaths = sketchBoxes.flatMap(([x, y, w, h]) => [wobble(x, y, w, h), wobble(x, y, w, h)]);
// duet: two hand-played voices that wind around each other, over a perfectly periodic machine spectrum
const voice = (phase: number, freq: number, wob: number) =>
  range(121).map((k) => {
    const x = 110 + k * 8;
    const amp = 62 + 38 * Math.sin(x * 0.0042 + phase) + (rnd() - 0.5) * wob;
    const y = 330 + amp * Math.sin(x * freq + phase);
    return `${k ? 'L' : 'M'}${x} ${y.toFixed(1)}`;
  }).join(' ');
const duetA = voice(0, 0.0105, 6);
const duetB = voice(Math.PI * 0.85, 0.0098, 6);
const spectrum = range(40).map((i) => ({ x: 112 + i * 24.5, h: [26, 52, 34, 78, 34, 52][i % 6] }));
// generative: a seeded network, so every slug gets a different picture (the default for new posts)
const gNodes = range(22).map(() => ({ x: 130 + rnd() * 940, y: 110 + rnd() * 420 }));
const near = (i: number) => gNodes.map((n, j) => ({ j, d: (n.x - gNodes[i].x) ** 2 + (n.y - gNodes[i].y) ** 2 })).filter((o) => o.j !== i).sort((a, b) => a.d - b.d);
const gEdges = gNodes.flatMap((_, i) => near(i).slice(0, 2).map((o) => [i, o.j]));
const gPath = [gNodes.reduce((best, n, i) => (n.x < gNodes[best].x ? i : best), 0)];
while (gPath.length < 6) {
  const last = gPath[gPath.length - 1];
  const next = near(last).find((o) => !gPath.includes(o.j) && gNodes[o.j].x > gNodes[last].x) ?? near(last).find((o) => !gPath.includes(o.j))!;
  gPath.push(next.j);
}
---
<svg class:list={['cover', { 'cover--compact': compact, 'cover--banner': banner }]} viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Cover illustration" preserveAspectRatio="xMidYMid slice">
  <defs>
    <pattern id={`dots-${slug}`} width="24" height="24" patternUnits="userSpaceOnUse">
      <circle cx="1" cy="1" r="1" fill="#ecefea" opacity="0.08" />
    </pattern>
    <radialGradient id={`glow-${slug}`} cx="78%" cy="30%" r="60%">
      <stop offset="0" stop-color={M} stop-opacity="0.18" />
      <stop offset="1" stop-color={M} stop-opacity="0" />
    </radialGradient>
  </defs>
  <rect width={W} height={H} fill="#0d1311" />
  <rect width={W} height={H} fill={`url(#dots-${slug})`} />
  <rect width={W} height={H} fill={`url(#glow-${slug})`} />

  {motif === 'paths' && (
    <g fill="none" stroke-width="3" stroke-linecap="round">
      <circle cx="140" cy="330" r="10" fill={T} />
      {branches.map((b) => (
        <path d={`M140 330 C ${b.bend * 0.6} 330, ${b.bend * 0.7} ${b.y}, ${b.bend} ${b.y} L ${b.end} ${b.y}`} stroke={b.hl ? M : D} stroke-width={b.hl ? 5 : 3} />
      ))}
      {branches.map((b) => <circle cx={b.end} cy={b.y} r={b.hl ? 12 : 7} fill={b.hl ? M : D} stroke="none" />)}
    </g>
  )}

  {motif === 'deploy' && (
    <g fill="none" stroke-width="3">
      <rect x="120" y="200" width="240" height="240" rx="18" stroke={D} />
      <rect x="840" y="160" width="260" height="320" rx="18" stroke={T} />
      <text x="150" y="240" fill="#55665e" font-family="IBM Plex Mono" font-size="20">VENDOR</text>
      <text x="870" y="200" fill={T} font-family="IBM Plex Mono" font-size="20">CLIENT ENV</text>
      <path d="M360 320 C 520 320, 620 300, 840 300" stroke={M} stroke-width="5" stroke-dasharray="2 14" stroke-linecap="round" />
      <circle cx="610" cy="308" r="16" fill={M} stroke="none" />
      {range(3).map((i) => <rect x={880} y={250 + i * 64} width={180} height={44} rx="8" stroke={i === 1 ? M : D} />)}
    </g>
  )}

  {motif === 'civic' && (
    <g>
      {civic.map((c) => (
        <g>
          <path d={`M${c.x - 26} ${c.y + 22} V ${c.y - 6} L ${c.x} ${c.y - 28} L ${c.x + 26} ${c.y - 6} V ${c.y + 22} Z`} fill="none" stroke={c.lit ? M : D} stroke-width="3" />
          {c.lit && <circle cx={c.x} cy={c.y + 4} r="6" fill={M} />}
        </g>
      ))}
    </g>
  )}

  {motif === 'shield' && (
    <g fill="none" stroke-width="3">
      {range(5).map((i) => (
        <rect x={300 + i * 30} y={110 + i * 30} width={600 - i * 60} height={420 - i * 60} rx={26} stroke={i === 4 ? M : D} stroke-width={i === 4 ? 5 : 3} />
      ))}
      <path d="M560 300 l30 30 l60 -70" stroke={M} stroke-width="8" stroke-linecap="round" stroke-linejoin="round" />
    </g>
  )}

  {motif === 'brush' && (
    <g fill="none" stroke-width="3">
      {range(8).map((i) => <line x1={160 + i * 40} y1="140" x2={160 + i * 40} y2="500" stroke={D} />)}
      <path d="M150 460 C 380 120, 560 560, 760 260 S 1020 180, 1060 160" stroke={M} stroke-width="10" stroke-linecap="round" />
      <text x="760" y="520" fill={T} font-family="Archivo Variable" font-weight="800" font-size="120" style="font-stretch:72%">Aa</text>
      <text x="960" y="520" fill="#55665e" font-family="serif" font-style="italic" font-size="120" text-decoration="line-through">Aa</text>
    </g>
  )}

  {motif === 'triad' && (
    <g>
      {[[380, 300, 150, '#199e70'], [600, 330, 150, '#3987e5'], [820, 300, 150, '#d95926']].map(([x, y, r, c]) => (
        <circle cx={x} cy={y} r={r} fill="none" stroke={c as string} stroke-width="5" opacity="0.95" />
      ))}
      <circle cx="600" cy="300" r="14" fill={M} />
    </g>
  )}

  {motif === 'chip' && (
    <g>
      <rect x="210" y="120" width="780" height="400" rx="22" fill="none" stroke={D} stroke-width="3" />
      {bits.map((b) => <rect x={b.x} y={b.y} width="44" height="44" rx="6" fill={b.hl ? M : b.on ? '#2a3732' : 'none'} stroke={b.hl ? M : D} stroke-width="2" />)}
      {range(10).map((i) => <line x1={250 + i * 76} y1="96" x2={250 + i * 76} y2="120" stroke={D} stroke-width="4" />)}
      {range(10).map((i) => <line x1={250 + i * 76} y1="520" x2={250 + i * 76} y2="544" stroke={D} stroke-width="4" />)}
    </g>
  )}

  {motif === 'stack' && (
    <g fill="none" stroke-width="3">
      {range(4).map((i) => (
        <path d={`M600 ${170 + i * 90} L 900 ${250 + i * 90} L 600 ${330 + i * 90} L 300 ${250 + i * 90} Z`} stroke={i === 0 ? M : D} stroke-width={i === 0 ? 5 : 3} fill={i === 0 ? 'rgb(61 245 167 / 0.06)' : 'none'} />
      ))}
    </g>
  )}

  {motif === 'loop' && (
    <g fill="none" stroke-width="5" stroke-linecap="round">
      <path d="M300 220 C 520 120, 760 120, 920 240" stroke={D} />
      <path d="M920 420 C 720 540, 480 540, 300 420" stroke={M} />
      <path d="M905 205 l20 38 l-42 4" stroke={D} />
      <path d="M318 456 l-24 -36 l42 -6" stroke={M} />
      <circle cx="270" cy="320" r="46" stroke={T} />
      <circle cx="950" cy="320" r="46" stroke={T} />
    </g>
  )}

  {motif === 'drift' && (
    <g fill="none" stroke-width="4">
      <line x1="120" y1="520" x2="1080" y2="520" stroke={D} stroke-width="2" />
      {drift.map((d, i) => (
        <path d={gauss(d.mu, d.sigma, 300 - i * 40)} stroke={d.hl ? M : i === 0 ? T : '#55665e'} stroke-width={d.hl ? 5 : 3} />
      ))}
      <path d="M400 150 H 830" stroke={M} stroke-width="3" stroke-dasharray="6 8" />
      <path d="M815 138 l16 12 l-16 12" stroke={M} stroke-width="3" />
    </g>
  )}

  {motif === 'fork' && (
    <g fill="none" stroke-width="3">
      <circle cx="140" cy="320" r="10" fill={T} stroke="none" />
      <path d="M140 320 H 430" stroke={T} />
      <path d="M430 320 C 560 320, 600 190, 750 190" stroke={D} />
      <path d="M430 320 C 560 320, 600 470, 760 470" stroke={M} stroke-width="5" />
      <rect x="760" y="80" width="320" height="220" rx="12" stroke={T} />
      {range(15).map((i) => <rect x={790 + (i % 5) * 56} y={108 + Math.floor(i / 5) * 62} width="36" height="40" rx="4" stroke={D} />)}
      <text x="760" y="64" fill="#55665e" font-family="IBM Plex Mono" font-size="20">EMPLOYEE</text>
      {clients.slice(1).map((c, i) => <line x1={clients[i].x} y1={clients[i].y} x2={c.x} y2={c.y} stroke={D} />)}
      <line x1="760" y1="470" x2={clients[0].x} y2={clients[0].y} stroke={M} stroke-width="3" />
      {clients.map((c) => <circle cx={c.x} cy={c.y} r={c.hl ? 13 : 9} fill={c.hl ? M : '#0d1311'} stroke={c.hl ? M : T} />)}
      <text x="760" y="610" fill={M} font-family="IBM Plex Mono" font-size="20">CONTRACTOR</text>
    </g>
  )}

  {motif === 'pipeline' && (
    <g fill="none" stroke-width="4" stroke-linecap="round">
      <path d="M100 400 H 1100" stroke={D} />
      <path d="M220 400 C 260 400, 260 230, 320 230 H 620 C 680 230, 680 400, 720 400" stroke={T} />
      {[300, 400, 500, 600].map((x) => <circle cx={x === 300 ? 330 : x} cy="230" r="11" fill="#0d1311" stroke={T} />)}
      {[140, 220, 720, 860, 1000].map((x) => <circle cx={x} cy="400" r="11" fill="#0d1311" stroke={D} />)}
      {[[420, false], [560, false], [790, false], [930, true]].map(([x, hl]) => (
        <g>
          <rect x={(x as number) - 34} y="300" width="68" height="200" rx="12" stroke={hl ? M : '#55665e'} stroke-width={hl ? 5 : 3} fill={hl ? 'rgb(61 245 167 / 0.06)' : 'none'} />
          <path d={`M${(x as number) - 14} 540 l10 10 l22 -24`} stroke={M} stroke-width="5" stroke-linejoin="round" />
        </g>
      ))}
      <circle cx="1060" cy="400" r="18" fill={M} stroke="none" />
      <rect x="110" y="190" width="56" height="44" rx="8" stroke={M} stroke-width="4" />
      <path d="M122 190 v-14 a16 16 0 0 1 32 0 v14" stroke={M} stroke-width="4" />
      <text x="100" y="140" fill="#55665e" font-family="IBM Plex Mono" font-size="20">@sha256</text>
    </g>
  )}

  {motif === 'budget' && (
    <g fill="none" stroke-width="3">
      <rect x="110" y="160" width="360" height="290" rx="16" stroke={T} />
      <path d="M110 205 H 470" stroke={T} />
      {range(3).map((i) => <circle cx={140 + i * 24} cy="183" r="6" stroke={D} />)}
      {range(4).map((i) => <rect x="145" y={235 + i * 50} width={i === 0 ? 290 : 200 - i * 30} height="26" rx="6" stroke={i === 0 ? M : D} />)}
      <path d="M480 305 C 560 305, 580 305, 640 305" stroke={M} stroke-width="5" stroke-dasharray="2 14" stroke-linecap="round" />
      <ellipse cx="760" cy="200" rx="110" ry="34" stroke={T} />
      <path d="M650 200 V 410 a110 34 0 0 0 220 0 V 200" stroke={T} />
      <path d="M650 270 a110 34 0 0 0 220 0 M650 340 a110 34 0 0 0 220 0" stroke={D} />
      <path d="M940 470 A 110 110 0 0 1 1160 470" stroke={D} stroke-width="10" stroke-linecap="round" />
      <path d="M940 470 A 110 110 0 0 1 962 404" stroke={M} stroke-width="10" stroke-linecap="round" />
      <path d="M1050 470 L 972 432" stroke={M} stroke-width="5" stroke-linecap="round" />
      <circle cx="1050" cy="470" r="9" fill={M} stroke="none" />
      <text x="1012" y="548" fill={M} font-family="Archivo Variable" font-weight="800" font-size="56" style="font-stretch:72%">$0</text>
    </g>
  )}

  {motif === 'sketch' && (
    <g fill="none" stroke-linecap="round" stroke-linejoin="round">
      {sketchPaths.map((d, i) => <path d={d} stroke={i % 2 ? '#55665e' : T} stroke-width={i % 2 ? 2 : 3} />)}
      <path d="M600 110 V 560" stroke={M} stroke-width="4" stroke-dasharray="4 12" />
      <rect x="566" y="300" width="68" height="40" rx="8" fill="#0d1311" stroke={M} stroke-width="3" />
      <text x="579" y="327" fill={M} font-family="IBM Plex Mono" font-size="17">STOP</text>
      {sketchBoxes.map(([x, y, w, h]) => <rect x={x + 570} y={y} width={w} height={h} rx="4" stroke={T} stroke-width="3" />)}
      <path d="M720 525 H 1050 M720 515 v20 M1050 515 v20" stroke={M} stroke-width="2" />
      <path d="M1080 150 V 480 M1070 150 h20 M1070 480 h20" stroke={M} stroke-width="2" />
      <text x="150" y="560" fill="#55665e" font-family="IBM Plex Mono" font-size="20">SKETCH</text>
      <text x="720" y="590" fill={T} font-family="IBM Plex Mono" font-size="20">BUILD</text>
    </g>
  )}

  {motif === 'podium' && (
    <g fill="none" stroke-width="3">
      <path d="M200 540 H 1000" stroke={D} />
      <rect x="290" y="360" width="200" height="180" rx="8" stroke={T} />
      <rect x="500" y="280" width="200" height="260" rx="8" stroke={M} stroke-width="5" fill="rgb(61 245 167 / 0.06)" />
      <rect x="710" y="410" width="200" height="130" rx="8" stroke={D} />
      <text x="372" y="460" fill={T} font-family="Archivo Variable" font-weight="800" font-size="72" style="font-stretch:72%">2</text>
      <text x="580" y="400" fill={M} font-family="Archivo Variable" font-weight="800" font-size="96" style="font-stretch:72%">1</text>
      <text x="790" y="495" fill="#55665e" font-family="Archivo Variable" font-weight="800" font-size="64" style="font-stretch:72%">3</text>
      <path d="M600 250 l-30 -60 h60 z" stroke={M} stroke-linejoin="round" />
      <circle cx="1010" cy="190" r="80" stroke={D} stroke-width="8" />
      <path d="M1010 110 A 80 80 0 1 1 930 190" stroke={M} stroke-width="8" stroke-linecap="round" />
      <path d="M1010 190 V 140 M1010 190 L 1046 214" stroke={T} stroke-width="5" stroke-linecap="round" />
      <path d="M990 92 h40" stroke={T} stroke-width="6" stroke-linecap="round" />
    </g>
  )}

  {motif === 'dialogue' && (
    <g fill="none" stroke-width="3" stroke-linejoin="round">
      <path d="M110 110 H 560 a16 16 0 0 1 16 16 V 220 a16 16 0 0 1 -16 16 H 170 l-30 30 v-30 h-14 a16 16 0 0 1 -16 -16 Z" stroke={T} />
      {range(3).map((i) => <path d={`M140 ${145 + i * 30} H ${540 - i * 70}`} stroke={D} stroke-width="8" stroke-linecap="round" />)}
      <path d="M110 300 H 430 a16 16 0 0 1 16 16 V 384 a16 16 0 0 1 -16 16 H 170 l-30 30 v-30 h-14 a16 16 0 0 1 -16 -16 Z" stroke="#55665e" />
      {range(2).map((i) => <path d={`M140 ${335 + i * 30} H ${400 - i * 90}`} stroke={D} stroke-width="8" stroke-linecap="round" />)}
      <path d="M110 470 H 270 a16 16 0 0 1 16 16 V 524 a16 16 0 0 1 -16 16 H 170 l-30 30 v-30 h-14 a16 16 0 0 1 -16 -16 Z" stroke={M} stroke-width="4" />
      <path d="M140 505 H 240" stroke={M} stroke-width="8" stroke-linecap="round" />
      <text x="600" y="180" fill="#55665e" font-family="IBM Plex Mono" font-size="18">ELI5</text>
      <text x="470" y="360" fill="#55665e" font-family="IBM Plex Mono" font-size="18">INTERN</text>
      <text x="310" y="515" fill={M} font-family="IBM Plex Mono" font-size="18">CAVEMAN</text>
      <rect x="760" y="150" width="340" height="340" rx="18" stroke={T} />
      <path d="M760 200 H 1100" stroke={T} />
      {range(3).map((i) => <circle cx={790 + i * 24} cy="175" r="6" stroke={D} />)}
      <path d="M800 260 l26 22 l-26 22" stroke={M} stroke-width="5" stroke-linecap="round" />
      <path d="M846 304 H 900" stroke={M} stroke-width="5" stroke-linecap="round" />
      {range(3).map((i) => <path d={`M800 ${360 + i * 36} H ${1050 - i * 80}`} stroke={D} stroke-width="8" stroke-linecap="round" />)}
    </g>
  )}

  {motif === 'duet' && (
    <g fill="none" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="1010" cy="150" r="78" stroke={D} stroke-width="3" fill="rgb(61 245 167 / 0.04)" />
      <circle cx="985" cy="128" r="14" stroke={D} stroke-width="2" />
      <circle cx="1040" cy="176" r="9" stroke={D} stroke-width="2" />
      <circle cx="1002" cy="190" r="6" stroke={D} stroke-width="2" />
      {spectrum.map((b) => <rect x={b.x} y={600 - b.h} width="14" height={b.h} rx="3" fill={D} />)}
      <path d={duetB} stroke={T} stroke-width="3" opacity="0.9" />
      <path d={duetA} stroke={M} stroke-width="5" />
      <circle cx="110" cy="330" r="9" fill={M} stroke="none" />
    </g>
  )}

  {motif === 'generative' && (
    <g fill="none" stroke-linecap="round">
      {gEdges.map(([a, b]) => <line x1={gNodes[a].x} y1={gNodes[a].y} x2={gNodes[b].x} y2={gNodes[b].y} stroke={D} stroke-width="2" />)}
      <path d={`M${gPath.map((i) => `${gNodes[i].x.toFixed(1)} ${gNodes[i].y.toFixed(1)}`).join(' L')}`} stroke={M} stroke-width="5" stroke-linejoin="round" />
      {gNodes.map((n, i) => <circle cx={n.x} cy={n.y} r={gPath.includes(i) ? 10 : 6} fill={gPath.includes(i) ? M : '#0d1311'} stroke={gPath.includes(i) ? M : T} stroke-width="2" />)}
    </g>
  )}

  {index && <text x="56" y={H - 52} fill="#ecefea" opacity="0.5" font-family="IBM Plex Mono" font-size="22" letter-spacing="4">{index}</text>}
</svg>

<style>
  .cover { display: block; width: 100%; height: auto; aspect-ratio: 15 / 8; border-radius: 18px; border: 1px solid var(--line); }
  .cover--compact { border-radius: 14px; }
  .cover--banner { aspect-ratio: 21 / 8; }
</style>
