---
/**
 * Line chart, 1–4 series. Categorical slots in fixed order (series-1..4); legend for ≥2 series,
 * direct end labels, single y-axis, hover dots with tooltips. Lines draw in on scroll.
 */
interface Series {
  name: string;
  points: { x: number | string; y: number }[];
  hl?: boolean;
}
interface Props {
  series: Series[];
  yMax?: number;
  yMin?: number;
  unit?: string;
  ticks?: number;
  height?: number;
  /** Optional shaded band, e.g. an alert threshold region: [yFrom, yTo, label] */
  band?: [number, number, string];
}
const { series, yMax, yMin = 0, unit = '', ticks = 4, height = 300, band } = Astro.props;
const W = 760;
const H = height;
const P = { l: 44, r: 150, t: 16, b: 34 };
const xs = series[0].points.map((p) => p.x);
const allY = series.flatMap((s) => s.points.map((p) => p.y));
const top = yMax ?? Math.ceil(Math.max(...allY) * 1.1);
const X = (i: number) => P.l + (i / Math.max(1, xs.length - 1)) * (W - P.l - P.r);
const Y = (v: number) => P.t + (1 - (v - yMin) / (top - yMin)) * (H - P.t - P.b);
const colors = ['var(--series-1)', 'var(--series-2)', 'var(--series-3)', 'var(--series-4)'];
const color = (s: Series, i: number) => (series.length === 1 || s.hl ? (series.length === 1 ? 'var(--emph)' : colors[i]) : colors[i]);
const tickVals = Array.from({ length: ticks + 1 }, (_, i) => yMin + ((top - yMin) / ticks) * i);
const path = (s: Series) => s.points.map((p, i) => `${i ? 'L' : 'M'}${X(i).toFixed(1)} ${Y(p.y).toFixed(1)}`).join(' ');
const xStep = Math.ceil(xs.length / 8);
---
<div>
  {series.length > 1 && (
    <div class="legend">{series.map((s, i) => <span><i style={`background:${colors[i]}`}></i>{s.name}</span>)}</div>
  )}
  <svg class="svgchart" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={series.map((s) => `${s.name}: ${s.points.map((p) => `${p.x} ${p.y}${unit}`).join(', ')}`).join('; ')}>
    {band && (
      <g>
        <rect x={P.l} y={Y(band[1])} width={W - P.l - P.r} height={Y(band[0]) - Y(band[1])} fill="rgb(217 89 38 / 0.10)" />
        <text x={P.l + 8} y={Y(band[1]) + 16} class="axis" fill="#d95926" font-size="11">{band[2]}</text>
      </g>
    )}
    <g class="grid">{tickVals.map((v) => <line x1={P.l} x2={W - P.r} y1={Y(v)} y2={Y(v)} />)}</g>
    <g class="axis">
      {tickVals.map((v) => <text x={P.l - 8} y={Y(v) + 4} text-anchor="end">{Math.round(v * 10) / 10}{unit}</text>)}
      {xs.map((x, i) => (i % xStep === 0 || i === xs.length - 1) && <text x={X(i)} y={H - 10} text-anchor="middle">{x}</text>)}
    </g>
    {series.map((s, i) => {
      const last = s.points[s.points.length - 1];
      return (
        <g>
          <path class="series draw" d={path(s)} stroke={color(s, i)} pathLength="1000" style="--len:1000" />
          {s.points.map((p, j) => (
            <circle class="dot" cx={X(j)} cy={Y(p.y)} r="4.5" fill={color(s, i)} data-tip={`${s.name} · ${p.x}: ${p.y}${unit}`} />
          ))}
          <text class="lbl" x={X(s.points.length - 1) + 10} y={Y(last.y) + 4}>{last.y}{unit}</text>
          <text class="lbl lbl--muted" x={X(s.points.length - 1) + 10} y={Y(last.y) + 19}>{s.name}</text>
        </g>
      );
    })}
  </svg>
</div>
