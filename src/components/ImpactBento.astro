---
// Each tile pairs a verified headline metric with a purpose-drawn mini visualisation.
const people = Array.from({ length: 20 }, (_, i) => i);
const dots = Array.from({ length: 122 }, (_, i) => i);
const LIT = 57; // the one lit dot in the 122-team field
const lanes = Array.from({ length: 10 }, (_, i) => i);

// Donut: 40% of circumference
const R = 52;
const C = 2 * Math.PI * R;
---
<section class="section impact" id="impact" aria-labelledby="impact-title">
  <span class="coord">§03 · outcomes</span>
  <div class="wrap">
    <header class="section-head" data-reveal>
      <p class="eyebrow"><span class="idx">03</span> Impact, by the numbers</p>
      <h2 id="impact-title">Work measured in <em>outcomes</em>, not in demos.</h2>
      <p>Every figure comes from a real engagement — the company and project are on each tile, and projections are labelled as such.</p>
    </header>

    <div class="bento">
      <!-- A · 95% FTE -->
      <article class="tile tile--a panel" data-reveal>
        <div class="tile__top">
          <p class="tile__num numeral"><span data-count="95">95</span>%</p>
          <p class="tile__label">less FTE needed for Next-Best-Action model development</p>
          <p class="tile__src mono">AIA Digital+ · up to 95% · end-to-end NBA data pipeline</p>
        </div>
        <div class="fte" role="img" aria-label="Twenty analysts reduced to one">
          {people.map((i) => (
            <svg class:list={['fte__p', { 'fte__p--keep': i === 0 }]} viewBox="0 0 24 32" aria-hidden="true" data-fte={i}>
              <circle cx="12" cy="8" r="6" />
              <path d="M2 31c0-7 4.5-12 10-12s10 5 10 12z" />
            </svg>
          ))}
        </div>
        <p class="fte__legend mono"><span class="k">●</span> after &nbsp;·&nbsp; <span class="d">●</span> effort removed</p>
      </article>

      <!-- B · 10–30× throughput -->
      <article class="tile tile--b panel" data-reveal>
        <div class="tile__top">
          <p class="tile__num numeral">10–<span data-count="30">30</span>×</p>
          <p class="tile__label">document throughput — hours of turnaround cut to minutes</p>
          <p class="tile__src mono">Document Intelligence Pipeline · batch / page / region concurrency</p>
        </div>
        <div class="lanes" aria-hidden="true">
          <div class="lanes__group">
            <span class="lanes__tag mono">before · sequential</span>
            <div class="lane"><span class="lane__bar lane__bar--slow"></span></div>
          </div>
          <div class="lanes__group">
            <span class="lanes__tag mono">after · async fan-out</span>
            {lanes.map((i) => (
              <div class="lane lane--thin"><span class="lane__bar" style={`--d:${(i * 0.13).toFixed(2)}s; --w:${70 + ((i * 37) % 30)}%`}></span></div>
            ))}
          </div>
        </div>
      </article>

      <!-- C · ~40% donut -->
      <article class="tile tile--c panel" data-reveal>
        <svg class="donut" viewBox="0 0 128 128" role="img" aria-label="Forty percent of retrieval cost removed">
          <circle cx="64" cy="64" r={R} class="donut__track" />
          <circle
            cx="64" cy="64" r={R}
            class="donut__val"
            stroke-dasharray={`${(C * 0.4).toFixed(1)} ${C.toFixed(1)}`}
            transform="rotate(-90 64 64)"
            data-donut
          />
          <text x="64" y="62" text-anchor="middle" class="donut__num">~40%</text>
          <text x="64" y="80" text-anchor="middle" class="donut__sub">cost saved</text>
        </svg>
        <p class="tile__label">retrieval cost reduction via an LLM-driven RAG-skip gate</p>
        <p class="tile__src mono">Hybrid RAG · Cohere rerank</p>
      </article>

      <!-- D · 20% ramp -->
      <article class="tile tile--d panel" data-reveal>
        <p class="tile__num tile__num--sm numeral"><span data-count="20">20</span>%+</p>
        <svg class="ramp" viewBox="0 0 200 110" role="img" aria-label="Agents reach proficiency at least 20% sooner">
          <line x1="8" y1="24" x2="196" y2="24" class="ramp__goal" />
          <text x="196" y="18" text-anchor="end" class="ramp__t">proficient</text>
          <path d="M8 102 C 70 100, 120 60, 190 24" class="ramp__before" />
          <path d="M8 102 C 50 98, 90 50, 148 24" class="ramp__after" data-draw />
          <circle cx="148" cy="24" r="4" class="ramp__dot" />
        </svg>
        <p class="tile__label">faster time-to-proficiency with an LLM training simulator</p>
        <p class="tile__src mono">TDCX AI · global BPO</p>
      </article>

      <!-- E · 122 teams -->
      <article class="tile tile--e panel" data-reveal>
        <div class="tile__top">
          <p class="tile__num numeral">2<sup>nd</sup><span class="tile__of">/ <span data-count="122">122</span></span></p>
          <p class="tile__label">teams at the UN Big Data Hackathon — Best Youth Team, Asia</p>
          <p class="tile__src mono">International · 2023</p>
        </div>
        <div class="field" role="img" aria-label="122 competing teams, one highlighted">
          {dots.map((i) => <span class:list={['field__dot', { 'field__dot--lit': i === LIT }]}></span>)}
        </div>
      </article>

      <!-- F · 25% claims -->
      <article class="tile tile--f panel" data-reveal>
        <div class="tile__top">
          <p class="tile__num numeral"><span data-count="25">25</span>%</p>
          <p class="tile__label">projected cut in claim-processing time from automated fraud screening</p>
          <p class="tile__src mono">AIA Digital+ · fraud detection · projected</p>
        </div>
        <div class="bars" aria-hidden="true">
          <div class="bars__row"><span class="mono">manual review</span><span class="bars__bar" style="--w:100%"></span></div>
          <div class="bars__row"><span class="mono">with model</span><span class="bars__bar bars__bar--new" style="--w:75%"></span></div>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .bento {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-rows: minmax(220px, auto);
    gap: 16px;
  }
  .tile { padding: clamp(22px, 2.4vw, 32px); display: flex; flex-direction: column; gap: 14px; overflow: hidden; }
  .tile--a { grid-column: span 2; grid-row: span 2; }
  .tile--b { grid-column: span 2; }
  .tile--e, .tile--f { grid-column: span 2; }
  .tile__top { display: grid; gap: 10px; }
  .tile__num { font-size: clamp(3.5rem, 2rem + 4vw, 6.5rem); }
  .tile--a .tile__num { font-size: var(--fs-numeral); }
  .tile__num--sm { font-size: clamp(3rem, 2rem + 2.4vw, 4.25rem); }
  .tile__num sup { font-size: 0.4em; vertical-align: super; font-style: normal; }
  .tile__of { font-size: 0.42em; color: var(--muted); margin-left: 0.25em; letter-spacing: -0.02em; }
  .tile__label { color: var(--text); font-size: 1rem; line-height: 1.45; max-width: 440px; }
  .tile__src { font-size: 10.5px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }

  /* A — FTE glyphs */
  .fte {
    margin-top: auto;
    display: grid;
    grid-template-columns: repeat(10, 1fr);
    gap: clamp(8px, 1.4vw, 18px);
  }
  .fte__p { width: 100%; fill: var(--line-2); transition: fill 0.4s, opacity 0.4s; }
  .fte__p--keep { fill: var(--signal); filter: drop-shadow(0 0 8px var(--signal-glow)); }
  .fte__legend { font-size: 11px; color: var(--muted); letter-spacing: 0.06em; }
  .fte__legend .k { color: var(--signal); }
  .fte__legend .d { color: var(--line-2); }

  /* B — lanes */
  .lanes { display: grid; gap: 14px; margin-top: auto; }
  .lanes__group { display: grid; gap: 4px; }
  .lanes__tag { font-size: 10.5px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); margin-bottom: 4px; }
  .lane { height: 10px; border-radius: 3px; background: var(--ink-3); overflow: hidden; }
  .lane--thin { height: 5px; }
  .lane__bar { display: block; height: 100%; width: var(--w, 100%); background: var(--signal); border-radius: inherit; transform-origin: left; animation: fill 2.4s var(--ease-out) var(--d, 0s) infinite; }
  .lane__bar--slow { background: var(--muted); animation-duration: 12s; }
  @keyframes fill { 0% { transform: scaleX(0); } 70%, 100% { transform: scaleX(1); } }

  /* C — donut */
  .tile--c { align-items: flex-start; }
  .donut { width: min(150px, 100%); }
  .donut circle { fill: none; stroke-width: 12; }
  .donut__track { stroke: var(--ink-3); }
  .donut__val { stroke: var(--signal); stroke-linecap: round; filter: drop-shadow(0 0 6px var(--signal-glow)); }
  .donut__num { fill: var(--text); font-family: var(--font-display); font-weight: 700; font-size: 24px; }
  .donut__sub { fill: var(--muted); font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.1em; text-transform: uppercase; }

  /* D — ramp */
  .ramp { width: 100%; }
  .ramp path { fill: none; stroke-width: 2; }
  .ramp__before { stroke: var(--line-2); stroke-dasharray: 3 4; }
  .ramp__after { stroke: var(--signal); }
  .ramp__goal { stroke: var(--line-2); }
  .ramp__dot { fill: var(--signal); }
  .ramp__t { fill: var(--muted); font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.1em; text-transform: uppercase; }

  /* E — dot field */
  .tile--e { flex-direction: row; align-items: center; gap: 28px; }
  .tile--e .tile__top { flex: 1 1 50%; }
  .field { flex: 1 1 50%; display: grid; grid-template-columns: repeat(14, 1fr); gap: 6px; }
  .field__dot { aspect-ratio: 1; border-radius: 50%; background: var(--line-2); }
  .field__dot--lit { background: var(--signal); box-shadow: 0 0 0 4px var(--signal-dim), 0 0 18px var(--signal); }

  /* F — bars */
  .tile--f .bars { margin-top: auto; display: grid; gap: 12px; }
  .bars__row { display: grid; grid-template-columns: 110px 1fr; align-items: center; gap: 14px; }
  .bars__row .mono { font-size: 11px; color: var(--muted); letter-spacing: 0.06em; }
  .bars__bar { display: block; height: 14px; width: var(--w); border-radius: 3px; background: var(--line-2); }
  .bars__bar--new { background: var(--signal); }

  @media (max-width: 1080px) {
    .bento { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .tile--a, .tile--b, .tile--e, .tile--f { grid-column: span 2; }
    .tile--a { grid-row: auto; }
  }
  @media (max-width: 600px) {
    .bento { grid-template-columns: 1fr; }
    .tile--a, .tile--b, .tile--e, .tile--f { grid-column: auto; }
    .tile--e { flex-direction: column; align-items: stretch; }
  }
</style>
