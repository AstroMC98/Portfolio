---
import { PROJECTS } from '../data/projects';
import { CASE_META, FILTERS } from '../data/caseMeta';
import ArchDiagram from './ArchDiagram.astro';

const all = PROJECTS.map((p, i) => ({ p, m: CASE_META[p.id], n: String(i + 1).padStart(2, '0') }));
const featured = all.filter((x) => x.m?.featured);
const rest = all.filter((x) => !x.m?.featured);
---
<section class="section work" id="work" aria-labelledby="work-title">
  <span class="coord">§05 · case files</span>
  <div class="wrap">
    <header class="section-head" data-reveal>
      <p class="eyebrow"><span class="idx">05</span> Selected work</p>
      <h2 id="work-title">Nine systems. <em>Architecture, code and outcomes</em> for each.</h2>
      <p>
        Eight in production, one clearly-marked prototype. Every case file is a full write-up: the business problem, the system
        architecture, the engineering decisions with annotated code, and the outcomes.
      </p>
    </header>

    <div class="filters" role="toolbar" aria-label="Filter case studies" data-filters>
      {FILTERS.map((f, i) => (
        <button class:list={['filter', { 'is-on': i === 0 }]} data-filter={f} aria-pressed={i === 0 ? 'true' : 'false'}>
          {f}
          <span class="filter__n mono">{f === 'All' ? all.length : all.filter((x) => x.m?.tags.includes(f)).length}</span>
        </button>
      ))}
    </div>

    <div class="features">
      {featured.map(({ p, m, n }, i) => (
        <article class:list={['feature', { 'feature--flip': i % 2 === 1 }]} data-case data-tags={m.tags.join(' ')} data-reveal>
          <div class="feature__copy">
            <div class="feature__meta">
              <span class="feature__n mono">{n}</span>
              <span class="chip chip--signal"><span class="status-dot" aria-hidden="true"></span>{p.status}</span>
              {m.tags.map((t) => <span class="chip">{t}</span>)}
            </div>
            <h3 class="feature__title">{p.title}</h3>
            <p class="feature__sub mono">{p.subtitle}</p>

            <div class="feature__kpi">
              <span class="feature__num numeral">{m.headline.prefix}<span data-count={m.headline.value}>{m.headline.value}</span>{m.headline.suffix}</span>
              <span class="feature__kpi-label">{m.headline.label}</span>
            </div>

            <p class="feature__desc">{p.description}</p>

            <dl class="feature__facts">
              <div><dt class="mono">My role</dt><dd>{m.role}</dd></div>
              <div><dt class="mono">Stack</dt><dd class="feature__stack">{p.tech.map((t) => <span class="chip">{t.label}</span>)}</dd></div>
            </dl>

            <a class="btn btn--primary feature__cta" href={`/work/${p.id}/`}>
              Read the case file <span class="arrow" aria-hidden="true">→</span>
            </a>
          </div>

          <figure class="feature__fig">
            <div class="feature__frame">
              <span class="feature__fig-tag mono">FIG. {n} — SYSTEM ARCHITECTURE</span>
              <ArchDiagram id={`dg-${p.id}`} diagram={m.diagram!} label={`Architecture of ${p.title}: ${m.diagram!.caption}`} />
            </div>
            <figcaption>{m.diagram!.caption}</figcaption>
          </figure>
        </article>
      ))}
    </div>

    <a class="labcta" href="/work/d2lt-enhanced/#lab" data-reveal>
      <span class="labcta__live mono"><span aria-hidden="true"></span>Interactive</span>
      <span class="labcta__title">Burst-traffic lab</span>
      <span class="labcta__body">Fire a burst of LLM calls through a naive rate limiter and the one I shipped — watch the 429s disappear. Runs in your browser.</span>
      <span class="labcta__go mono">Open the lab →</span>
    </a>

    <div class="cards">
      {rest.map(({ p, m, n }) => (
        <article class="card panel" data-case data-tags={m.tags.join(' ')} data-reveal>
          <div class="card__meta">
            <span class="feature__n mono">{n}</span>
            {p.status === 'Prototype' ? (
              <span class="chip chip--amber"><span class="status-dot status-dot--amber" aria-hidden="true"></span>Prototype</span>
            ) : (
              <span class="chip chip--signal"><span class="status-dot" aria-hidden="true"></span>Production</span>
            )}
          </div>
          <h3 class="card__title">{p.title}</h3>
          <p class="card__sub mono">{p.subtitle}</p>
          <p class="card__kpi">
            <span class="numeral">{m.headline.prefix}{m.headline.value}{m.headline.suffix}</span>
            <span>{m.headline.label}</span>
          </p>
          <ol class="card__flow" aria-label="System flow">
            {p.details.architecture.slice(0, 4).map((a) => <li>{a.name}</li>)}
          </ol>
          <div class="card__foot">
            <span class="card__tags">{m.tags.map((t) => <span class="chip">{t}</span>)}</span>
            <a class="link-arrow card__link" href={`/work/${p.id}/`}>Read the case file <span aria-hidden="true">→</span></a>
          </div>
        </article>
      ))}
      <aside class="card card--cta" data-reveal>
        <p class="eyebrow">Go deeper</p>
        <p class="card--cta__title">Want the full story behind any of these?</p>
        <p class="card--cta__body">The résumé covers scope, team size and timelines. I’m happy to walk through architecture and trade-offs live.</p>
        <div class="card--cta__actions">
          <a class="btn btn--primary btn--sm" href="/resume.pdf" download>Résumé <span class="arrow arrow--down" aria-hidden="true">↓</span></a>
          <a class="btn btn--sm" href="#contact">Get in touch <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </aside>
    </div>

    <p class="work__note mono">Metrics come from project-specific observation windows — happy to walk through any of them in an interview.</p>
  </div>
</section>

<style>
  .filters { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 40px; }
  .filter {
    display: inline-flex; align-items: center; gap: 10px;
    height: 40px; padding-inline: 16px;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    font-size: 0.9rem;
    color: var(--text-2);
    transition: all 0.25s;
  }
  .filter:hover { border-color: var(--text-2); color: var(--text); }
  .filter.is-on { background: var(--text); color: var(--ink); border-color: var(--text); }
  .filter__n { font-size: 11px; opacity: 0.6; }

  /* Feature spreads */
  .features { display: grid; gap: clamp(24px, 3vw, 40px); }
  .feature {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: clamp(28px, 4vw, 64px);
    align-items: center;
    padding: clamp(24px, 3.5vw, 48px);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(600px 300px at 100% 0%, rgb(61 245 167 / 0.05), transparent 70%),
      linear-gradient(180deg, var(--ink-2), rgb(17 23 21 / 0.4));
    transition: border-color 0.3s;
  }
  .feature:hover { border-color: var(--line-2); }
  .feature--flip .feature__copy { order: 2; }
  .feature--flip { background:
      radial-gradient(600px 300px at 0% 0%, rgb(61 245 167 / 0.05), transparent 70%),
      linear-gradient(180deg, var(--ink-2), rgb(17 23 21 / 0.4)); }
  .feature__copy { display: grid; gap: 18px; justify-items: start; }
  .feature__meta, .card__meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .feature__n { font-size: 12px; color: var(--muted); letter-spacing: 0.12em; margin-right: 6px; }
  .feature__title {
    font-family: var(--font-display);
    font-stretch: 72%;
    font-weight: 650;
    font-size: var(--fs-xl);
    letter-spacing: -0.02em;
  }
  .feature__sub, .card__sub { font-size: 12px; letter-spacing: 0.04em; color: var(--muted); margin-top: -10px; }
  .feature__kpi {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: end;
    gap: 18px;
    padding-block: 18px;
    border-block: 1px solid var(--line);
    width: 100%;
  }
  .feature__num { font-size: clamp(3.5rem, 2rem + 4vw, 6rem); }
  .feature__kpi-label { color: var(--text); font-size: 1rem; line-height: 1.4; padding-bottom: 6px; max-width: 280px; }
  .feature__desc { color: var(--text-2); font-size: 0.98rem; }
  .feature__facts { display: grid; gap: 12px; width: 100%; }
  .feature__facts > div { display: grid; grid-template-columns: 84px 1fr; gap: 14px; align-items: start; }
  .feature__facts dt { font-size: 10.5px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--signal); padding-top: 5px; }
  .feature__facts dd { font-size: 0.92rem; color: var(--text); }
  .feature__stack { display: flex; flex-wrap: wrap; gap: 6px; }
  .feature__cta { margin-top: 4px; }

  .feature__fig { display: grid; gap: 14px; }
  .feature__frame {
    position: relative;
    padding: clamp(28px, 3vw, 40px) clamp(10px, 1.6vw, 22px) clamp(14px, 2vw, 22px);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background-color: rgb(10 13 12 / 0.7);
    background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 32px 32px;
    background-position: -1px -1px;
  }
  .feature__fig-tag { position: absolute; top: 12px; left: 16px; font-size: 10px; letter-spacing: 0.18em; color: var(--muted); }
  .feature__fig figcaption { font-size: 0.85rem; color: var(--muted); line-height: 1.5; }

  /* Compact cards */
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 360px), 1fr));
    gap: 16px;
    margin-top: 16px;
  }
  .card { position: relative; padding: 26px; display: flex; flex-direction: column; gap: 14px; transition: border-color 0.3s, transform 0.4s var(--ease-out); }
  .card__link::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .card:hover { border-color: var(--line-2); transform: translateY(-3px); }
  .card__title { font-family: var(--font-display); font-stretch: 84%; font-weight: 650; font-size: 1.5rem; letter-spacing: -0.015em; }
  .card__kpi { display: grid; grid-template-columns: auto 1fr; gap: 14px; align-items: center; font-size: 0.9rem; color: var(--text-2); line-height: 1.4; }
  .card__kpi .numeral { font-size: 2.75rem; }
  .card__flow { display: flex; flex-wrap: wrap; gap: 6px 4px; align-items: center; counter-reset: f; }
  .card__flow li {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-2);
    padding: 5px 9px;
    background: var(--ink-3);
    border: 1px solid var(--line);
    border-radius: 6px;
  }
  .card__flow li + li::before { content: '→'; color: var(--signal); margin-right: 8px; margin-left: -2px; }
  .card__foot { margin-top: auto; display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; padding-top: 6px; }
  .card__tags { display: flex; gap: 6px; }

  .card--cta {
    justify-content: center;
    border: 1px dashed rgb(61 245 167 / 0.4);
    border-radius: var(--radius-lg);
    background: radial-gradient(400px 260px at 100% 100%, rgb(61 245 167 / 0.1), transparent 70%);
  }
  .card--cta__title { font-family: var(--font-display); font-stretch: 84%; font-weight: 600; font-size: 1.6rem; line-height: 1.15; letter-spacing: -0.015em; }
  .card--cta__body { color: var(--text-2); font-size: 0.92rem; }
  .card--cta__actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 6px; }
  .card--cta:hover { transform: none; }
  .labcta {
    display: grid; grid-template-columns: auto auto 1fr auto; align-items: center; gap: 12px 24px;
    margin-top: 16px; padding: 22px 26px;
    border: 1px solid rgb(61 245 167 / 0.4); border-radius: var(--radius-lg);
    background: linear-gradient(90deg, rgb(61 245 167 / 0.08), transparent 60%), var(--ink-2);
    transition: border-color 0.3s, transform 0.4s var(--ease-out);
  }
  .labcta:hover { border-color: var(--signal); transform: translateY(-2px); }
  .labcta__live { display: inline-flex; align-items: center; gap: 8px; font-size: 10.5px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--signal); }
  .labcta__live span { width: 7px; height: 7px; border-radius: 50%; background: var(--signal); animation: pulse 2.4s infinite; }
  .labcta__title { font-family: var(--font-display); font-stretch: 72%; font-weight: 800; font-size: 1.7rem; text-transform: uppercase; line-height: 1; }
  .labcta__body { color: var(--text-2); font-size: 0.92rem; }
  .labcta__go { font-size: 12px; color: var(--signal); white-space: nowrap; }
  @media (max-width: 900px) { .labcta { grid-template-columns: 1fr; } }
  [data-case][hidden] { display: none !important; }
  .work__note { margin-top: 28px; font-size: 11.5px; letter-spacing: 0.04em; color: var(--muted); }

  @media (max-width: 1000px) {
    .feature { grid-template-columns: 1fr; }
    .feature--flip .feature__copy { order: 0; }
  }
  @media (max-width: 640px) {
    /* Keep diagram labels legible on phones: scroll the figure instead of shrinking it */
    .feature__frame { overflow-x: auto; scrollbar-width: thin; }
    .feature__frame :global(.arch) { min-width: 560px; }
    .feature__fig figcaption::before { content: 'Swipe the diagram → '; color: var(--signal); font-family: var(--font-mono); font-size: 11px; }
  }
  @media (max-width: 520px) {
    .feature__kpi { grid-template-columns: 1fr; gap: 6px; }
    .feature__facts > div { grid-template-columns: 1fr; gap: 6px; }
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-filters]');
  const cases = document.querySelectorAll<HTMLElement>('[data-case]');
  bar?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-filter]');
    if (!btn) return;
    const f = btn.dataset.filter!;
    bar.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((b) => {
      const on = b === btn;
      b.classList.toggle('is-on', on);
      b.setAttribute('aria-pressed', String(on));
    });
    cases.forEach((c) => {
      c.hidden = f !== 'All' && !c.dataset.tags!.split(' ').includes(f);
    });
    window.dispatchEvent(new Event('resize')); // let ScrollTrigger re-measure
  });
</script>
