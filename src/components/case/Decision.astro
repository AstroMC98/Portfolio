---
/**
 * One engineering decision (a "snippet" in projects.ts) as a long-form chapter:
 * plain-terms summary → problem → before/after → how it works → stepped code walkthrough → impact.
 */
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import CodePane from './CodePane.astro';
import ArchModel from './ArchModel.astro';

interface Props {
  s: any;
  index: number;
  pid: string;
}
const { s, index, pid } = Astro.props;
const n = String(index + 1).padStart(2, '0');
const uid = `${pid}-d${index + 1}`;
const ch = s.challenge || {};
const comp = ch.comparison;
const steps: any[] = s.steps || [];
const first = steps[0] || {};

const implSource = readFileSync(join(process.cwd(), 'public', 'snippets', s.file), 'utf8').replace(/\s+$/, '');
const classicLines: { n: number; t: string }[] = s.classic?.lines || [];
const hasArch = !!s.arch;

// Panes shown in the walkthrough viewer, first one active.
const panes = [
  ...(hasArch ? [{ key: 'arch', label: 'Architecture' }] : []),
  { key: 'impl', label: 'Implementation' },
  ...(!hasArch && classicLines.length ? [{ key: 'classic', label: s.classic.label || 'Classic approach' }] : []),
];
---
<article class="dec" id={`decision-${index + 1}`} data-decision>
  <header class="dec__head">
    <p class="dec__n mono"><span>Decision {n}</span>{ch.eyebrow && <span class="muted"> · {ch.eyebrow}</span>}</p>
    <h3 class="dec__title">{s.label}</h3>
    {s.executiveNote && (
      <p class="dec__plain"><b class="mono">In plain terms</b>{s.executiveNote}</p>
    )}
  </header>

  <div class="dec__problem">
    <p class="dec__kicker mono">The problem</p>
    <h4 class="dec__headline">{ch.headline}</h4>
    <p class="dec__body">{ch.body}</p>
  </div>

  {comp && (
    <div class="vs">
      <div class="vs__card vs__card--before">
        <span class="vs__tag mono">Before · {comp.classic.label}</span>
        <p>{comp.classic.desc}</p>
        {comp.classic.verdict && <p class="vs__verdict">✗ {comp.classic.verdict}</p>}
      </div>
      <span class="vs__arrow" aria-hidden="true">→</span>
      <div class="vs__card vs__card--after">
        <span class="vs__tag mono">After · {comp.impl.label}</span>
        <p>{comp.impl.desc}</p>
        {comp.impl.verdict && <p class="vs__verdict">✓ {comp.impl.verdict}</p>}
      </div>
    </div>
  )}

  {ch.items && (
    <div class="manual">
      <p class="dec__kicker mono">The manual process it replaced</p>
      <ol class="manual__list">{ch.items.map((it: string) => <li>{it}</li>)}</ol>
      {ch.verdict && <p class="vs__verdict vs__verdict--bad">✗ {ch.verdict}</p>}
    </div>
  )}

  {s.process && (
    <figure class="flow">
      <figcaption class="flow__title"><span class="dec__kicker mono">How it works</span>{s.process.title}</figcaption>
      <ol class="flow__steps">
        {s.process.steps.map((p: any, i: number) => (
          <li class="flow__step">
            <span class="flow__i mono">{String(i + 1).padStart(2, '0')}</span>
            <span class="flow__label">{p.label}</span>
            {p.note && <span class="flow__note">{p.note}</span>}
          </li>
        ))}
      </ol>
      {s.process.guarantee && <p class="flow__guarantee mono">✓ {s.process.guarantee}</p>}
    </figure>
  )}

  {steps.length > 0 && (
    <div class="walk" data-walk>
      <div class="walk__narr">
        <p class="dec__kicker mono">Code walkthrough — {steps.length} steps · scroll or click</p>
        <ol class="walk__steps">
          {steps.map((st, i) => (
            <li>
              <button
                class:list={['wstep', { 'is-active': i === 0 }]}
                data-step={i}
                data-li={JSON.stringify(st.li || [])}
                data-lc={JSON.stringify(st.lc || [])}
                data-arch={st.archStep ?? ''}
                aria-pressed={i === 0 ? 'true' : 'false'}
              >
                <span class="wstep__hdr"><span class="wstep__tag mono">{st.tag}</span><span class="mono muted">{String(i + 1).padStart(2, '0')} / {String(steps.length).padStart(2, '0')}</span></span>
                <span class="wstep__title">{st.title}</span>
                <span class="wstep__body">{st.body}</span>
                {st.stat?.num && (
                  <span class="wstep__stat"><b>{st.stat.num}{st.stat.suffix}</b><span>{st.stat.unit}{st.stat.desc && ` — ${st.stat.desc}`}</span></span>
                )}
              </button>
            </li>
          ))}
        </ol>
      </div>

      <div class="walk__viewer">
        <div class="viewer">
          <div class="viewer__hdr">
            <div class="viewer__tabs" role="tablist">
              {panes.map((p, i) => (
                <button class="viewer__tab" role="tab" data-pane={p.key} aria-selected={i === 0 ? 'true' : 'false'}>{p.label}</button>
              ))}
            </div>
            <span class="viewer__file mono">{s.file}</span>
          </div>
          {hasArch && (
            <div class="viewer__pane is-active" data-pane-body="arch"><ArchModel arch={s.arch} uid={uid} /></div>
          )}
          <div class:list={['viewer__pane', { 'is-active': !hasArch }]} data-pane-body="impl">
            <CodePane code={implSource} initial={first.li || []} />
          </div>
          {!hasArch && classicLines.length > 0 && (
            <div class="viewer__pane" data-pane-body="classic">
              <CodePane code={classicLines.map((l) => l.t).join('\n')} numbers={classicLines.map((l) => l.n)} initial={first.lc || []} />
            </div>
          )}
        </div>
      </div>
    </div>
  )}

  {s.impact?.stats?.length > 0 && (
    <div class="dec__impact">
      <p class="dec__kicker mono">{s.impact.eyebrow || 'The impact'}</p>
      <div class="dec__stats">
        {s.impact.stats.map((x: any) => (
          <div class="dstat">
            <b class="dstat__num">{x.big}{x.bigSuffix}</b>
            <span class="dstat__unit mono">{x.unit}</span>
            <span class="dstat__desc">{x.desc}</span>
          </div>
        ))}
      </div>
      {s.impact.caption && <p class="dec__caption">{s.impact.caption}</p>}
    </div>
  )}
</article>

<style>
  .dec { overflow-wrap: anywhere; display: grid; grid-template-columns: minmax(0, 1fr); gap: clamp(32px, 4vw, 48px); padding-block: clamp(56px, 7vw, 96px); border-top: 1px solid var(--line); }
  .dec:first-of-type { border-top: 0; padding-top: 0; }
  .dec__n { font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--signal); }
  .dec__title { margin-top: 14px; font-family: var(--font-display); font-stretch: 72%; font-weight: 650; font-size: var(--fs-xl); letter-spacing: -0.02em; }
  .dec__plain { margin-top: 20px; max-width: 820px; padding: 16px 20px; border-left: 2px solid var(--signal); background: var(--signal-dim); border-radius: 0 12px 12px 0; color: var(--text); }
  .dec__plain b { display: block; margin-bottom: 6px; font-weight: 500; font-size: 10.5px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--signal); }
  .dec__kicker { display: block; margin-bottom: 12px; font-size: 10.5px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); }
  .dec__problem { max-width: 860px; }
  .dec__headline { font-family: var(--font-display); font-stretch: 84%; font-weight: 550; font-style: normal; font-size: clamp(1.4rem, 1.1rem + 1vw, 2rem); line-height: 1.2; letter-spacing: -0.01em; }
  .dec__body { margin-top: 14px; color: var(--text-2); font-size: var(--fs-md); }

  .vs { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); gap: 16px; align-items: stretch; }
  .vs__card { padding: 22px; border-radius: var(--radius); border: 1px solid var(--line); background: var(--ink-2); display: grid; gap: 10px; align-content: start; }
  .vs__card--before { border-color: rgb(255 181 71 / 0.25); }
  .vs__card--after { border-color: rgb(61 245 167 / 0.35); background: linear-gradient(180deg, rgb(61 245 167 / 0.05), var(--ink-2)); }
  .vs__tag { font-size: 10.5px; letter-spacing: 0.14em; text-transform: uppercase; }
  .vs__card--before .vs__tag { color: var(--amber); }
  .vs__card--after .vs__tag { color: var(--signal); }
  .vs__card p { color: var(--text-2); }
  .vs__verdict { font-size: 0.92rem; font-weight: 600; color: var(--text) !important; }
  .vs__card--before .vs__verdict, .vs__verdict--bad { color: var(--danger) !important; }
  .vs__card--after .vs__verdict { color: var(--signal) !important; }
  .vs__arrow { align-self: center; font-size: 1.6rem; color: var(--signal); }

  .manual__list { display: grid; gap: 8px; counter-reset: m; max-width: 820px; }
  .manual__list li { counter-increment: m; display: grid; grid-template-columns: 34px 1fr; color: var(--text-2); }
  .manual__list li::before { content: counter(m, decimal-leading-zero); font-family: var(--font-mono); font-size: 11.5px; color: var(--amber); padding-top: 3px; }
  .manual .vs__verdict { margin-top: 14px; }

  .flow { padding: clamp(20px, 3vw, 32px); border: 1px solid var(--line); border-radius: var(--radius-lg); background: rgb(17 23 21 / 0.6); }
  .flow__title { font-family: var(--font-display); font-stretch: 84%; font-weight: 600; font-size: 1.3rem; margin-bottom: 22px; }
  .flow__steps { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 190px), 1fr)); gap: 0; counter-reset: f; }
  .flow__step { min-width: 0; }
  .flow__step { position: relative; display: grid; gap: 8px; align-content: start; padding: 18px 18px 6px 0; border-top: 2px solid var(--line-2); }
  .flow__step::before { content: ''; position: absolute; top: -7px; left: 0; width: 12px; height: 12px; border-radius: 50%; background: var(--ink); border: 2px solid var(--signal); }
  .flow__step:last-child { border-top-color: var(--signal); }
  .flow__step:last-child::before { background: var(--signal); }
  .flow__i { font-size: 11px; color: var(--signal); }
  .flow__label { font-family: var(--font-mono); font-size: 0.85rem; color: var(--text); line-height: 1.45; }
  .flow__note { font-size: 0.85rem; color: var(--muted); }
  .flow__guarantee { margin-top: 22px; display: inline-block; padding: 8px 14px; border: 1px dashed rgb(61 245 167 / 0.5); border-radius: 999px; font-size: 12px; color: var(--signal); }

  .walk { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: clamp(20px, 3vw, 40px); align-items: start; }
  .walk__narr { min-width: 0; }
  .walk__steps { display: grid; grid-template-columns: minmax(0, 1fr); gap: 12px; }
  .wstep { width: 100%; text-align: left; display: grid; gap: 8px; padding: 18px 20px; border: 1px solid var(--line); border-radius: 14px; background: var(--ink-2); opacity: 0.55; transition: opacity 0.3s, border-color 0.3s, background-color 0.3s; }
  .wstep:hover { opacity: 0.85; }
  .wstep.is-active { opacity: 1; border-color: var(--signal); background: rgb(61 245 167 / 0.04); }
  .wstep__hdr { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 12px; font-size: 11px; }
  .wstep__tag { color: var(--signal); letter-spacing: 0.1em; text-transform: uppercase; font-size: 10.5px; }
  .wstep__title { font-weight: 600; font-size: 1.02rem; }
  .wstep__body { color: var(--text-2); font-size: 0.92rem; }
  .wstep__stat { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 12px; padding-top: 4px; }
  .wstep__stat b { font-family: var(--font-display); font-weight: 700; font-size: 1.9rem; line-height: 1; color: var(--signal); }
  .wstep__stat span { font-size: 0.82rem; color: var(--muted); }

  .walk__viewer { position: sticky; top: 132px; }
  .viewer { border: 1px solid var(--line-2); border-radius: 14px; overflow: hidden; background: #070908; }
  .viewer__hdr { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 8px 10px; border-bottom: 1px solid var(--line); background: var(--ink-2); }
  .viewer__tabs { display: flex; gap: 4px; overflow-x: auto; min-width: 0; }
  .viewer__tab { height: 30px; padding-inline: 12px; border-radius: 8px; font-family: var(--font-mono); font-size: 11.5px; color: var(--muted); white-space: nowrap; }
  .viewer__tab[aria-selected='true'] { color: var(--signal); background: var(--ink-3); }
  .viewer__file { min-width: 0; font-size: 11px; color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  @media (max-width: 420px) { .viewer__file { display: none; } }
  .viewer__pane { display: none; position: relative; height: min(64vh, 600px); overflow: auto; scrollbar-width: thin; }
  .viewer__pane.is-active { display: block; }

  .dec__stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 14px; }
  .dstat { display: grid; gap: 6px; padding: 22px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--ink-2); }
  .dstat__num { font-family: var(--font-display); font-stretch: 72%; font-weight: 700; font-size: clamp(2.4rem, 1.8rem + 1.6vw, 3.4rem); line-height: 1; color: var(--signal); letter-spacing: -0.01em; }
  .dstat__unit { font-size: 10.5px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-2); }
  .dstat__desc { font-size: 0.88rem; color: var(--muted); }
  .dec__caption { margin-top: 18px; max-width: 860px; color: var(--text-2); font-style: normal; font-family: var(--font-display); font-size: 1.1rem; line-height: 1.5; }

  @media (max-width: 980px) {
    .walk { grid-template-columns: minmax(0, 1fr); }
    /* Phones/tablets: the viewer pins under the nav and the steps scroll beneath it */
    .walk__viewer { order: -1; top: 128px; z-index: 3; box-shadow: 0 18px 30px -12px rgb(0 0 0 / 0.8); }
    .viewer__pane { height: 36vh; }
  }
  @media (max-width: 640px) {
    .vs { grid-template-columns: 1fr; }
    .vs__arrow { transform: rotate(90deg); justify-self: center; }
  }
</style>
