---
/**
 * Stepped architecture model for "process" walkthroughs
 * (ported from the legacy snippet-viewer _buildSvg). Step state is applied by
 * src/scripts/casePage.ts using the JSON in data-steps.
 */
interface Props {
  arch: any;
  uid: string;
}
const { arch, uid } = Astro.props;
const first = arch.archSteps?.[0] ?? {};
const cls = (id: string) => {
  if ((first.active || []).includes(id)) return 'a';
  if ((first.secondary || []).includes(id)) return 's';
  if ((first.dim || []).includes(id)) return 'd';
  return '';
};
const id = (raw: string) => `${uid}-${raw}`;
---
<div class="ax" data-arch-model={JSON.stringify({ uid, ...arch, nodes: undefined, edges: undefined, extras: undefined })}>
  <svg viewBox={arch.viewBox} role="img" aria-label="Architecture model — highlights follow the walkthrough steps">
    <defs>
      <marker id={`${uid}-ar`} markerUnits="userSpaceOnUse" markerWidth="8" markerHeight="6" refX="8" refY="3" orient="auto">
        <polygon points="0 0,8 3,0 6" fill="#3a4a43" />
      </marker>
    </defs>
    {arch.edges.map((e: any) => e.d ? (
      <path class:list={['ax-e', { a: (first.edges || []).includes(e.id) }]} id={id(e.id)} d={e.d} stroke-dasharray={e.dashed ? '4 3' : undefined} marker-end={`url(#${uid}-ar)`} />
    ) : (
      <line class:list={['ax-e', { a: (first.edges || []).includes(e.id) }]} id={id(e.id)} x1={e.x1} y1={e.y1} x2={e.x2} y2={e.y2} marker-end={`url(#${uid}-ar)`} />
    ))}
    {(arch.extras || []).map((x: any) =>
      x.type === 'line' ? <line class="ax-x" x1={x.x1} y1={x.y1} x2={x.x2} y2={x.y2} />
      : x.type === 'text' ? <text class="ax-t" x={x.x} y={x.y} text-anchor={x.anchor || 'middle'} fill={x.fill} font-size={x.size}>{x.text}</text>
      : x.type === 'pulse' ? <circle class:list={['ax-pulse', { on: (first.active || []).includes(x.nodeId) }]} data-pulse={id(x.nodeId)} cx={x.cx} cy={x.cy} r="6" />
      : null
    )}
    {arch.nodes.map((n: any) => {
      const cx = n.x + n.w / 2;
      const cy = n.y + n.h / 2;
      return (
        <g class:list={['ax-n', cls(n.id)]} id={id(n.id)}>
          <rect x={n.x} y={n.y} width={n.w} height={n.h} rx="6" />
          {n.compound ? (
            <>
              <line class="ax-x" x1={n.x + 10} y1={cy} x2={n.x + n.w - 10} y2={cy} />
              <text x={cx} y={cy - 12} class:list={['ax-l', { 'ax-mono': n.mono }]}>{n.label1}</text>
              <text x={cx} y={cy + 21} class:list={['ax-l', { 'ax-mono': n.mono }]}>{n.label2}</text>
            </>
          ) : (
            <>
              <text x={cx} y={cy - 3} class:list={['ax-l', { 'ax-mono': n.mono, 'ax-b': n.bold }]}>{n.label1}</text>
              {n.label2 && <text x={cx} y={cy + 11} class:list={['ax-l', { 'ax-mono': n.mono }]}>{n.label2}</text>}
            </>
          )}
        </g>
      );
    })}
  </svg>
</div>

<style>
  .ax { display: grid; place-items: center; min-height: 100%; padding: 32px 18px; background-image: radial-gradient(circle at 1px 1px, rgb(236 239 234 / 0.06) 1px, transparent 0); background-size: 18px 18px; }
  .ax svg { width: 100%; max-width: 640px; overflow: visible; }
  .ax :global(.ax-e) { fill: none; stroke: #2a3732; stroke-width: 1.25; transition: stroke 0.3s; }
  .ax :global(.ax-e.a) { stroke: var(--signal); stroke-dasharray: 3 4; animation: dash 1.2s linear infinite; }
  .ax-x { stroke: rgb(255 255 255 / 0.12); }
  .ax-t { font-family: var(--font-mono); letter-spacing: 0.04em; }
  .ax :global(.ax-n) { transition: opacity 0.35s; }
  .ax :global(.ax-n rect) { fill: var(--ink-2); stroke: #2a3732; stroke-width: 1.25; transition: all 0.35s; }
  .ax-l { fill: var(--text-2); font-family: var(--font-sans); font-size: 8.5px; text-anchor: middle; letter-spacing: 0.03em; transition: fill 0.35s; }
  .ax-mono { font-family: var(--font-mono); }
  .ax-b { font-weight: 600; }
  .ax :global(.ax-n.a rect) { stroke: var(--signal); fill: #0f1d17; filter: drop-shadow(0 0 8px rgb(61 245 167 / 0.35)); }
  .ax :global(.ax-n.a .ax-l) { fill: var(--signal); }
  .ax :global(.ax-n.s rect) { stroke: #4a5c54; }
  .ax :global(.ax-n.d) { opacity: 0.3; }
  .ax :global(.ax-pulse) { fill: none; stroke: var(--signal); stroke-width: 1.5; opacity: 0; }
  .ax :global(.ax-pulse.on) { animation: ax-pulse 1.8s ease-out infinite; }
  @keyframes ax-pulse { 0% { r: 6; opacity: 0.8; } 100% { r: 46; opacity: 0; } }
</style>
